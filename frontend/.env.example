# Copy this file to .env.local and fill in your real keys
# NEVER commit .env.local to GitHub

# Claude API (Anthropic) — get from https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Google Gemini — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-YOUR_KEY_HERE

# Option A: Cloud database (Neon/Supabase — recommended for Vercel deployment)
# DATABASE_URL=postgresql://user:password@host/biochar_db?sslmode=require

# Option B: Local PostgreSQL development
POSTGRES_DB=biochar_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
